// AI-Powered Smart Internship Recommendation System
// Prisma schema — MongoDB-style collections modeled on SQLite for sandbox.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────
//  USERS (Students, Company users, Admins)
// ────────────────────────────────────────────────────────────
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  role          String   @default("STUDENT") // STUDENT | COMPANY | ADMIN
  avatarUrl     String?

  // Student-specific
  phone         String?
  college       String?
  degree        String?
  branch        String?
  cgpa          Float?
  graduationYear Int?
  skills        String   @default("[]") // JSON array
  interests     String   @default("[]")
  preferredLocations String @default("[]")
  languages     String   @default("[]")
  linkedin      String?
  github        String?
  portfolio     String?
  resumeUrl     String?
  resumeText    String? // extracted text for AI parsing
  extractedSkills String @default("[]") // AI-extracted skills from resume
  profileCompleted Int   @default(0) // 0-100

  // Company-specific
  companyId     String?
  company       Company? @relation(fields: [companyId], references: [id])

  isVerified    Boolean  @default(false)
  isApproved    Boolean  @default(true)
  emailVerified Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications  Application[]
  notifications Notification[]
  chatMessages  ChatMessage[]
  feedback      Feedback[]
  certificates  Certificate[]
}

// ────────────────────────────────────────────────────────────
//  COMPANIES
// ────────────────────────────────────────────────────────────
model Company {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  logoUrl       String?
  industry      String?
  description   String?
  website       String?
  location      String?
  size          String?  // startup | small | medium | large | enterprise
  verified      Boolean  @default(false)
  approved      Boolean  @default(true)
  rating        Float    @default(4.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  internships   Internship[]
  users         User[]
}

// ────────────────────────────────────────────────────────────
//  INTERNSHIPS
// ────────────────────────────────────────────────────────────
model Internship {
  id            String   @id @default(cuid())
  title         String
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  description   String
  responsibilities String @default("[]") // JSON array
  requirements  String   @default("[]") // JSON array
  benefits      String   @default("[]")
  skills        String   @default("[]") // required skills (JSON array)
  domain        String   // e.g. "Data Science"
  location      String
  workMode      String   @default("onsite") // remote | hybrid | onsite
  duration      Int      // weeks
  stipend       Int      // INR per month
  openings      Int      @default(1)
  deadline      DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  applications  Application[]

  @@index([companyId])
  @@index([domain])
}

// ────────────────────────────────────────────────────────────
//  APPLICATIONS
// ────────────────────────────────────────────────────────────
model Application {
  id            String   @id @default(cuid())
  internshipId  String
  internship    Internship @relation(fields: [internshipId], references: [id])
  studentId     String
  student       User     @relation(fields: [studentId], references: [id])
  status        String   @default("APPLIED") // APPLIED | REVIEW | INTERVIEW | SELECTED | REJECTED
  matchScore    Float    @default(0) // AI match percentage 0-100
  matchingSkills String  @default("[]")
  missingSkills String   @default("[]")
  coverLetter   String?
  interviewScheduledAt DateTime?
  feedback      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([studentId])
  @@index([internshipId])
  @@unique([internshipId, studentId])
}

// ────────────────────────────────────────────────────────────
//  NOTIFICATIONS
// ────────────────────────────────────────────────────────────
model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  title         String
  message       String
  type          String   @default("INFO") // INFO | SUCCESS | WARNING | INTERVIEW | APPLICATION
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

// ────────────────────────────────────────────────────────────
//  CHAT HISTORY (AI assistant)
// ────────────────────────────────────────────────────────────
model ChatMessage {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  role          String   // user | assistant
  content       String
  createdAt     DateTime @default(now())
}

// ────────────────────────────────────────────────────────────
//  CERTIFICATES (generated when application SELECTED + week tracker complete)
// ────────────────────────────────────────────────────────────
model Certificate {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  internshipId  String
  internshipTitle String
  companyName   String
  studentName   String
  issueDate     DateTime @default(now())
  certificateId String   @unique // public-facing ID
  skills        String   @default("[]")
}

// ────────────────────────────────────────────────────────────
//  FEEDBACK
// ────────────────────────────────────────────────────────────
model Feedback {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  internshipId  String?
  rating        Int      // 1-5
  comment       String?
  createdAt     DateTime @default(now())
}
